rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == "anaflousoussama555@gmail.com"; }

    match /profiles/{pid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.ratingSum == 0
        && request.resource.data.ratingCount == 0;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum','ratingCount']))
      );
      allow delete: if isAdmin();

      match /ratings/{uid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && uid == request.auth.uid
          && request.resource.data.value is int
          && request.resource.data.value >= 1
          && request.resource.data.value <= 10;
      }
      match /comments/{cid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      }
    }
  }
}
